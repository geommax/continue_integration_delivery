tmpfs Volume Type
------------

⚠️ Linux only
🔥 Data disappears when container stops


docker run -d \
  --name tmpfs-test \
  -p 8083:80 \
  --tmpfs /usr/share/nginx/html \
  nginx

docker ps -a --filter volume=webdata

docker exec -it tmpfs-test bash
echo "RAM DATA" > /usr/share/nginx/html/index.html
exit


docker restart tmpfs-test


