Real-world Example (Volume + Network)
------------------------------------------------------------------------------------

docker network create app_net
docker volume create app_data

docker run -d \
  --name db \
  --network app_net \
  -v app_data:/data/db \
  mongo

docker run -d \
  --name backend \
  --network app_net \
  -p 3000:3000 \
  node

