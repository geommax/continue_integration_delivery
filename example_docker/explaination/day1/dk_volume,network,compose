------------------------------------------------------------------------------------------------
1 Create volume type of Named Volume

docker volume create mydata
docker volume ls
docker volume inspect mydata


------------
Run container with volume

docker run -d \
  --name web1 \
  -v mydata:/usr/share/nginx/html \
  -p 8080:80 \
  nginx


------------
Write data into volume

docker exec -it web1 bash
echo "Hello Students" > /usr/share/nginx/html/index.html
exit

------------
Delete container (important demo moment)

docker rm -f web1


------------

Recreate container using same volume

docker run -d \
  --name web2 \
  -v mydata:/usr/share/nginx/html \
  nginx



